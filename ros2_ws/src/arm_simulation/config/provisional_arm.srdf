<robot name="provisional_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0" />
  </group>
  <group name="gripper">
    <joint name="sim_finger_joint" />
  </group>
  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="arm" />
  <group_state name="home" group="arm">
    <joint name="sim_joint_1" value="0" />
    <joint name="sim_joint_2" value="0" />
    <joint name="sim_joint_3" value="0" />
    <joint name="sim_joint_4" value="0" />
    <joint name="sim_joint_5" value="0" />
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="sim_joint_1" value="0" />
    <joint name="sim_joint_2" value="0.35" />
    <joint name="sim_joint_3" value="-0.7" />
    <joint name="sim_joint_4" value="0" />
    <joint name="sim_joint_5" value="0.35" />
  </group_state>
  <group_state name="left_bin" group="arm">
    <joint name="sim_joint_1" value="0.6" />
    <joint name="sim_joint_2" value="0.4" />
    <joint name="sim_joint_3" value="-0.7" />
    <joint name="sim_joint_4" value="0" />
    <joint name="sim_joint_5" value="0.3" />
  </group_state>
  <group_state name="right_bin" group="arm">
    <joint name="sim_joint_1" value="-0.6" />
    <joint name="sim_joint_2" value="0.4" />
    <joint name="sim_joint_3" value="-0.7" />
    <joint name="sim_joint_4" value="0" />
    <joint name="sim_joint_5" value="0.3" />
  </group_state>
  <disable_collisions link1="base_link" link2="base_rotor" reason="Adjacent" />
  <disable_collisions link1="base_rotor" link2="upper_arm" reason="Adjacent" />
  <disable_collisions link1="upper_arm" link2="forearm" reason="Adjacent" />
  <disable_collisions link1="forearm" link2="wrist_pitch" reason="Adjacent" />
  <disable_collisions link1="wrist_pitch" link2="gripper_palm" reason="Adjacent" />
  <disable_collisions link1="gripper_palm" link2="left_finger" reason="Adjacent" />
  <disable_collisions link1="gripper_palm" link2="right_finger" reason="Adjacent" />
  <disable_collisions link1="gripper_palm" link2="camera_link" reason="Adjacent" />
  <disable_collisions link1="wrist_pitch" link2="camera_link" reason="Adjacent" />
  <disable_collisions link1="left_finger" link2="camera_link" reason="Adjacent" />
  <disable_collisions link1="right_finger" link2="camera_link" reason="Adjacent" />
</robot>