<?xml version="1.0"?>
<!-- Final user axis distances, 2026-10-29. Collision/visual shapes and masses are
approximations. The pictured linkage is represented by two mirrored hinged jaws;
its exact four-bar dimensions and servo linkage remain unmeasured. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="provisional_arm">
<xacro:arg name="gazebo" default="false"/>
<xacro:arg name="controllers" default=""/>
<xacro:arg name="sorting" default="false"/>
<xacro:property name="g" value="${xacro.load_yaml('../config/geometry.yaml')}"/>
<xacro:property name="shoulder_to_elbow" value="${g['motor2_to_motor3']}"/>
<xacro:property name="elbow_to_wrist" value="${g['motor3_to_motor4']}"/>
<link name="world"/>

<link name="base_link"><inertial><origin xyz="0 0 ${g['ground_to_motor1']/2}"/><mass value="1.0"/><inertia ixx="${(0.12**2+g['ground_to_motor1']**2)/12}" ixy="0" ixz="0" iyy="${(0.12**2+g['ground_to_motor1']**2)/12}" iyz="0" izz="0.0024"/></inertial><visual><origin xyz="0 0 ${g['ground_to_motor1']/2}"/><geometry><box size="0.12 0.12 ${g['ground_to_motor1']}"/></geometry><material name="base_link_colour"><color rgba=".12 .14 .18 1"/></material></visual><collision><origin xyz="0 0 ${g['ground_to_motor1']/2}"/><geometry><box size="0.12 0.12 ${g['ground_to_motor1']}"/></geometry></collision></link>
<joint name="world_fixed" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0"/></joint>
<link name="base_rotor"><inertial><origin xyz="0 0 ${(g['motor1_to_motor2'])/2}"/><mass value="0.2"/><inertia ixx="${0.2*(0.06**2+(g['motor1_to_motor2'])**2)/12}" ixy="0" ixz="0" iyy="${0.2*(0.06**2+(g['motor1_to_motor2'])**2)/12}" iyz="0" izz="${0.2*(0.06**2+0.06**2)/12}"/></inertial><visual><origin xyz="0 0 ${(g['motor1_to_motor2'])/2}"/><geometry><box size="0.06 0.06 ${g['motor1_to_motor2']}"/></geometry><material name="base_rotor_colour"><color rgba=".15 .4 .75 1"/></material></visual><collision><origin xyz="0 0 ${(g['motor1_to_motor2'])/2}"/><geometry><box size="0.06 0.06 ${g['motor1_to_motor2']}"/></geometry></collision></link>
<joint name="sim_joint_1" type="revolute"><parent link="base_link"/><child link="base_rotor"/><origin xyz="0 0 ${g['ground_to_motor1']}"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="upper_arm"><inertial><origin xyz="0 0 ${shoulder_to_elbow / 2}"/><mass value="0.3"/><inertia ixx="${0.3 * (0.035**2 + shoulder_to_elbow**2) / 12}" ixy="0" ixz="0" iyy="${0.3 * (0.035**2 + shoulder_to_elbow**2) / 12}" iyz="0" izz="6.125000000000001e-05"/></inertial><visual><origin xyz="0 0 ${shoulder_to_elbow / 2}"/><geometry><box size="0.035 0.035 ${shoulder_to_elbow}"/></geometry><material name="upper_arm_colour"><color rgba=".15 .4 .75 1"/></material></visual><collision><origin xyz="0 0 ${shoulder_to_elbow / 2}"/><geometry><box size="0.035 0.035 ${shoulder_to_elbow}"/></geometry></collision></link>
<joint name="sim_joint_2" type="revolute"><parent link="base_rotor"/><child link="upper_arm"/><origin xyz="0 0 ${g['motor1_to_motor2']}"/><axis xyz="0 1 0"/><limit lower="-1.4" upper="1.4" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="forearm"><inertial><origin xyz="0 0 ${elbow_to_wrist / 2}"/><mass value="0.25"/><inertia ixx="${0.25 * (0.03**2 + elbow_to_wrist**2) / 12}" ixy="0" ixz="0" iyy="${0.25 * (0.03**2 + elbow_to_wrist**2) / 12}" iyz="0" izz="3.75e-05"/></inertial><visual><origin xyz="0 0 ${elbow_to_wrist / 2}"/><geometry><box size="0.03 0.03 ${elbow_to_wrist}"/></geometry><material name="forearm_colour"><color rgba=".15 .4 .75 1"/></material></visual><collision><origin xyz="0 0 ${elbow_to_wrist / 2}"/><geometry><box size="0.03 0.03 ${elbow_to_wrist}"/></geometry></collision></link>
<joint name="sim_joint_3" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 ${shoulder_to_elbow}"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="2.0" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="wrist_pitch"><inertial><origin xyz="0 0 ${(g['motor4_to_motor5'])/2}"/><mass value="0.08"/><inertia ixx="${0.08*(0.04**2+(g['motor4_to_motor5'])**2)/12}" ixy="0" ixz="0" iyy="${0.08*(0.04**2+(g['motor4_to_motor5'])**2)/12}" iyz="0" izz="${0.08*(0.04**2+0.04**2)/12}"/></inertial><visual><origin xyz="0 0 ${(g['motor4_to_motor5'])/2}"/><geometry><box size="0.04 0.04 ${g['motor4_to_motor5']}"/></geometry><material name="wrist_pitch_colour"><color rgba=".15 .4 .75 1"/></material></visual><collision><origin xyz="0 0 ${(g['motor4_to_motor5'])/2}"/><geometry><box size="0.04 0.04 ${g['motor4_to_motor5']}"/></geometry></collision></link>
<joint name="sim_joint_4" type="revolute"><parent link="forearm"/><child link="wrist_pitch"/><origin xyz="0 0 ${elbow_to_wrist}"/><axis xyz="0 0 1"/><limit lower="-1.5" upper="1.5" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="gripper_palm"><inertial><origin xyz="0 0 ${(g['motor5_to_gripper_motor'])/2}"/><mass value="0.1"/><inertia ixx="${0.1*(0.045**2+(g['motor5_to_gripper_motor'])**2)/12}" ixy="0" ixz="0" iyy="${0.1*(0.04**2+(g['motor5_to_gripper_motor'])**2)/12}" iyz="0" izz="${0.1*(0.04**2+0.045**2)/12}"/></inertial><visual><origin xyz="0 0 ${(g['motor5_to_gripper_motor'])/2}"/><geometry><box size="0.04 0.045 ${g['motor5_to_gripper_motor']}"/></geometry><material name="gripper_palm_colour"><color rgba=".15 .4 .75 1"/></material></visual><collision><origin xyz="0 0 ${(g['motor5_to_gripper_motor'])/2}"/><geometry><box size="0.04 0.045 ${g['motor5_to_gripper_motor']}"/></geometry></collision></link>
<joint name="sim_joint_5" type="revolute"><parent link="wrist_pitch"/><child link="gripper_palm"/><origin xyz="0 0 ${g['motor4_to_motor5']}"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="left_finger"><inertial><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><mass value="0.025"/><inertia ixx="${0.025*(0.008**2+(g['gripper_motor_to_tip'])**2)/12}" ixy="0" ixz="0" iyy="${0.025*(0.012**2+(g['gripper_motor_to_tip'])**2)/12}" iyz="0" izz="${0.025*(0.012**2+0.008**2)/12}"/></inertial><visual><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><geometry><box size="0.012 0.008 ${g['gripper_motor_to_tip']}"/></geometry><material name="left_finger_colour"><color rgba=".9 .9 .85 1"/></material></visual><collision><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><geometry><box size="0.012 0.008 ${g['gripper_motor_to_tip']}"/></geometry></collision></link>
<joint name="sim_finger_joint" type="revolute"><parent link="gripper_palm"/><child link="left_finger"/><origin xyz="0 .012 ${g['motor5_to_gripper_motor']}"/><axis xyz="-1 0 0"/><limit lower="0.0" upper="0.4" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/></joint>
<link name="right_finger"><inertial><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><mass value="0.025"/><inertia ixx="${0.025*(0.008**2+(g['gripper_motor_to_tip'])**2)/12}" ixy="0" ixz="0" iyy="${0.025*(0.012**2+(g['gripper_motor_to_tip'])**2)/12}" iyz="0" izz="${0.025*(0.012**2+0.008**2)/12}"/></inertial><visual><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><geometry><box size="0.012 0.008 ${g['gripper_motor_to_tip']}"/></geometry><material name="right_finger_colour"><color rgba=".9 .9 .85 1"/></material></visual><collision><origin xyz="0 0 ${(g['gripper_motor_to_tip'])/2}"/><geometry><box size="0.012 0.008 ${g['gripper_motor_to_tip']}"/></geometry></collision></link>
<joint name="sim_finger_mimic" type="revolute"><parent link="gripper_palm"/><child link="right_finger"/><origin xyz="0 -.012 ${g['motor5_to_gripper_motor']}"/><axis xyz="1 0 0"/><limit lower="0.0" upper="0.4" effort="20" velocity="0.6"/><dynamics damping="0.1" friction="0.01"/><mimic joint="sim_finger_joint" multiplier="1" offset="0"/></joint>
<link name="gripper_motor_frame"/>
<joint name="gripper_motor_fixed" type="fixed"><parent link="gripper_palm"/><child link="gripper_motor_frame"/><origin xyz="0 0 ${g['motor5_to_gripper_motor']}"/></joint>
<link name="tool0"/>
<joint name="tool_fixed" type="fixed"><parent link="gripper_palm"/><child link="tool0"/><origin xyz="0 0 ${g['motor5_to_gripper_motor'] + g['gripper_motor_to_tip']}"/></joint>
<link name="camera_link"><inertial><origin xyz="0.035 0 0"/><mass value="0.015"/><inertia ixx="1.0625e-06" ixy="0" ixz="0" iyy="1.0625e-06" iyz="0" izz="1.5625e-06"/></inertial><visual><origin xyz="0.035 0 0"/><geometry><box size="0.025 0.025 0.015"/></geometry><material name="camera_link_colour"><color rgba=".1 .1 .1 1"/></material></visual><collision><origin xyz="0.035 0 0"/><geometry><box size="0.025 0.025 0.015"/></geometry></collision></link>
<joint name="camera_fixed" type="fixed"><parent link="gripper_palm"/><child link="camera_link"/><origin xyz="0 0 ${g['motor5_to_gripper_motor']}"/></joint>
<ros2_control name="SimulationOnly" type="system"><hardware><xacro:if value="$(arg gazebo)"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if><xacro:unless value="$(arg gazebo)"><plugin>mock_components/GenericSystem</plugin></xacro:unless></hardware>
<joint name="sim_joint_1"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_joint_2"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_joint_3"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_joint_4"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_joint_5"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_finger_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint>
<joint name="sim_finger_mimic"><state_interface name="position"/><state_interface name="velocity"/></joint></ros2_control>
<xacro:if value="$(arg gazebo)"><gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(arg controllers)</parameters></plugin></gazebo></xacro:if>
<!-- Generated attachment plugins for the selected sorting layout only. -->
<xacro:if value="$(arg sorting)">
  <xacro:include filename="sorting_attachments.xacro"/>
</xacro:if>
</robot>